# Hospital360 OS — environment template
# Copy to .env.local and fill with your Supabase project values.
# NEVER commit real keys. The anon key is safe for the browser; the SERVICE ROLE key is not.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: WhatsApp Business API (legitimate provider credentials only)
# WHATSAPP_CLOUD_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
